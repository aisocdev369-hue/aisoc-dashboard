{
  "name": "soc-dashboard",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "SOC Dashboard", "onAutoForward": "notify" }
  },
  "postCreateCommand": "[ -f .env ] || cp .env.example .env; python3 -m pip install --user --no-cache-dir -r backend/requirements.txt",
  "remoteUser": "codespace"
}
