{
  "name": "soc-dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "SOC Dashboard", "onAutoForward": "notify" }
  },
  "postCreateCommand": "[ -f .env ] || cp .env.example .env; pip install --no-cache-dir -r backend/requirements.txt",
  "remoteUser": "vscode"
}
