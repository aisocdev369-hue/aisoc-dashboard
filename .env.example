# Copy to .env for local or Codespaces use. Never commit .env.
# In Codespaces, store real values as Codespaces Secrets and export them
# instead of writing them into .env.
# Placeholders below are NOT secrets. Replace every "change-me" value.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL. POSTGRES_* values initialise the db container; DATABASE_URL is
# what the API uses. Keep the password identical in both places.
POSTGRES_DB=soc
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=change-me-dev-only
DATABASE_URL=postgresql+psycopg://soc_admin:change-me-dev-only@db:5432/soc

# CORS (comma-separated origins; keep narrow)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Monitoring: "mock" for Codespaces; "wazuh" or "suricata" when endpoints are reachable
MONITORING_MODE=mock

# Authentication. Generate a real value, for example: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never commit the real value.
JWT_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=60

# Gemini (Google AI Studio). Leave GEMINI_API_KEY empty to disable AI analysis.
# Store the real key in Codespaces Secrets, not in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
AI_MAX_ANALYSES_PER_USER_HOUR=20

# Added in later stages (leave blank for now):
# WAZUH_OPENSEARCH_URL=
# SURICATA_EVE_URL=
# TELEGRAM_BOT_TOKEN=
# SMTP_HOST=
